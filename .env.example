# MediaWiki API endpoint for Prospecting! Wiki
MEDIAWIKI_API_URL=https://prospecting.miraheze.org/w/api.php

# User-Agent sent to the wiki API
USER_AGENT=PICK/1.0 (Prospecting Information & Community Kit)

# Database (local PostgreSQL via docker-compose)
DATABASE_URL=postgresql+asyncpg://pick:pick@localhost:5432/pick

# Application settings
APP_NAME=PICK
APP_VERSION=0.1.0
DEBUG=false

# CORS allowed origins (comma-separated; use "*" for dev, list domains for prod)
# CORS_ORIGINS=https://pick.example.com,https://www.pick.example.com

# Frontend API base URL (set to your deployed backend URL when frontend is on DigitalOcean)
# VITE_API_BASE_URL=https://pick-api.example.com

# Push notifications for scripts/refresh_site.sh, via ntfy.sh.
# Anyone who knows the topic can read the messages, so treat it as a secret.
# NTFY_TOPIC=pick-refresh-your-own-topic