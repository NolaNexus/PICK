{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PICK Item Export v1",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "type", "data"],
        "properties": {
          "slug": {"type": "string"},
          "name": {"type": "string"},
          "type": {"type": "string"},
          "data": {"type": "object"},
          "image_url": {"type": ["string", "null"]},
          "source_revid": {"type": "integer"},
          "parser_version": {"type": "string"}
        }
      }
    }
  }
}
